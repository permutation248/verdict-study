          "ensures \\forall int i; 1 <= i < 16 ==> palette->ranges[i].it == 0;"
        ],
        "loop_contracts": {
          "palette_init_loop_0": [
            "loop invariant 0 <= i <= 256;",
            "loop invariant \\forall int k; 0 <= k < i ==> palette->colors[k].rgba == 0;",
            "loop assigns i, palette->colors[0..255].rgba;",
            "loop variant 256 - i;"
          ],
          "palette_init_loop_1": [
            "loop invariant 0 <= i_0 <= 16;",
